{:paths ["src" "resources"]

 ;; Sibling checkouts during development go in the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.2"}
        io.github.hive-agi/hive-addon {:mvn/version "1.1.3"}
        io.github.hive-agi/hive-spi {:mvn/version "1.4.4"}
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.17"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                     io.github.hive-agi/hive-test {:mvn/version "0.4.11"}
                     io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}
                     io.github.hive-agi/hive-vessel {:mvn/version "0.1.17"}}}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.11"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.40"}
                      io.github.hive-agi/hive-vessel {:mvn/version "0.1.17"}}
         :jvm-opts ["-Xmx1g"]
         :main-opts ["-m" "hive-olympus.test-runner"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.28"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
