{:paths ["src" "resources"]

 ;; Sibling checkouts during development go in the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        metosin/malli {:mvn/version "0.20.1"}
        io.github.hive-agi/hive-addon {:mvn/version "1.0.13"}
        io.github.hive-agi/hive-spi {:mvn/version "1.2.0"}
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.8"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                     io.github.hive-agi/hive-test {:mvn/version "0.4.8"}
                     io.github.hive-agi/hive-schemas {:mvn/version "0.1.36"}
                     io.github.hive-agi/hive-vessel {:mvn/version "0.1.8"}}}

  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.8"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.36"}
                      io.github.hive-agi/hive-vessel {:mvn/version "0.1.8"}}
         :jvm-opts ["-Xmx1g"]
         :main-opts ["-m" "hive-olympus.test-runner"]}

  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.21"}}
          :jvm-opts ["-Xmx1g"]
          :ns-default hive-build.api}}}
